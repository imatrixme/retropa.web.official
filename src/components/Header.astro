---
import Icon from "@/components/Icon.astro"
import type { Locale } from "@/i18n/locales"
import type { SitePage } from "@/lib/routes"
import { appStoreLink } from "@/lib/app-store-link"
import { languageTargets, languageTag, siteLink } from "@/lib/links"
import { navigationCopy, discoveryCopy } from "@/content/discovery"
import { chromeCopy } from "@/content/chrome"
import { featureContent } from "@/content/feature-pages"
import { getMessages } from "@/i18n/messages"
import { resolveCard } from "@/lib/link-cards"

interface Props { locale: Locale; page: SitePage }
const { locale, page } = Astro.props
const labels = navigationCopy(locale)
const discovery = discoveryCopy(locale)
const chrome = chromeCopy(locale)
const messages = getMessages(locale)
const nav = ([["cores", labels[0]], ["controls", featureContent("controls", locale).label], ["delta-skins", labels[1]], ["crt-filters", labels[2]], ["start", labels[3]]] as const).map(([target, label]) => ({ target, label, ...siteLink(target, locale) }))
const languages = languageTargets(page)
const productsPage = featureContent("products", locale)
const products = (productsPage.sections.find(section => section.catalogs?.length)?.catalogs ?? []).map(card => resolveCard(card, page, locale, "header"))
const productsLink = siteLink("products", locale)
const inProducts = page === "products" || page === "packhub"
---
<header class="site-header" data-header>
  <div class="bar">
    <a class="brand" href={siteLink("home", locale).href} aria-label={messages.shared.brand.homepageAriaLabel}>
      <img src="/brand/retropa-site-logo-192.png" width="32" height="32" alt="" />
      <span>Retropa</span>
    </a>
    <nav class="nav" aria-label={discovery.openMenu}>
      {nav.map(item => <a href={item.href} hreflang={item.hreflang} aria-current={page === item.target ? "page" : undefined} data-guide={item.target === "start" ? "" : undefined}>{item.label}{item.foreign && <small lang={item.hreflang}>{languageTag(item.hreflang)}</small>}</a>)}
      <details class="products" data-dismiss>
        <summary aria-current={inProducts ? "page" : undefined}>{productsPage.label}<Icon name="chevron-down" size={14} /></summary>
        <ul class="products-menu" role="list">
          {products.map(item => <li><a href={item.href} hreflang={item.hreflang} data-download={item.download}><span class="name">{item.title}</span>{item.note && <span class="note">{item.note}</span>}</a></li>)}
          <li class="all"><a href={productsLink.href} hreflang={productsLink.hreflang} aria-current={page === "products" ? "page" : undefined}>{productsPage.menuAll}<Icon name="arrow-right" size={14} /></a></li>
        </ul>
      </details>
    </nav>
    <div class="actions">
      <details class="lang" data-dismiss data-language-selector>
        <summary aria-label={`${chrome.language}: ${languages.find(l => l.locale === locale)?.label}`}><Icon name="globe" size={18} /><span class="hud">{languageTag(locale)}</span></summary>
        <ul class="lang-menu" role="list">
          {languages.map(item => <li><a href={item.href} hreflang={item.locale} lang={item.locale} aria-current={item.locale === locale ? "true" : undefined}>{item.label}</a></li>)}
        </ul>
      </details>
      <a class="get" href={appStoreLink(page)} data-download="header" aria-label={chrome.appStoreAlt}><Icon name="download" size={16} strokeWidth={2.2} /><span>{chrome.download}</span></a>
      <details class="menu" data-dismiss>
        <summary aria-label={discovery.openMenu}><Icon name="menu" size={22} class="i-open" /><Icon name="close" size={22} class="i-close" /></summary>
        <nav class="menu-sheet" aria-label={discovery.openMenu}>
          {nav.map((item, index) => <a href={item.href} hreflang={item.hreflang} data-guide={item.target === "start" ? "" : undefined}><span class="hud">0{index + 1}</span><span class="display">{item.label}</span><Icon name="arrow-up-right" size={22} /></a>)}
          <a href={productsLink.href} hreflang={productsLink.hreflang}><span class="hud">0{nav.length + 1}</span><span class="display">{productsPage.label}</span><Icon name="arrow-up-right" size={22} /></a>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; transition: background-color .3s, box-shadow .3s, backdrop-filter .3s; }
  .site-header.is-scrolled, .site-header:has(details[open]) { background: rgb(7 7 12 / .74); backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4); box-shadow: 0 1px 0 rgb(255 255 255 / .07); }
  .bar { display: flex; align-items: center; gap: 24px; height: 72px; padding: 0 clamp(16px, 3vw, 40px); color: #f4f2fb; }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand img { border-radius: 9px; box-shadow: 0 0 0 1px rgb(255 255 255 / .12), 0 6px 18px -6px rgb(246 196 83 / .5); }
  .brand span { font-family: var(--font-display); font-weight: 750; font-stretch: 116%; font-size: 21px; letter-spacing: -.02em; }
  .nav { display: none; gap: 4px; margin-inline: auto; }
  .nav > a { position: relative; display: inline-flex; white-space: nowrap; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px; font-size: 15px; font-weight: 500; color: rgb(244 242 251 / .72); transition: color .2s, background-color .2s; }
  .nav > a:hover { color: #fff; background: rgb(255 255 255 / .06); }
  .nav > a[aria-current="page"] { color: #fff; }
  .nav > a[aria-current="page"]::after { content: ""; position: absolute; left: 50%; bottom: 0; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 10px var(--signal); }
  .products { position: relative; }
  .products summary { position: relative; display: inline-flex; white-space: nowrap; align-items: center; gap: 4px; padding: 8px 12px 8px 14px; border-radius: 999px; font-size: 15px; font-weight: 500; color: rgb(244 242 251 / .72); transition: color .2s, background-color .2s; }
  .products summary:hover, .products[open] summary { color: #fff; background: rgb(255 255 255 / .06); }
  .products summary[aria-current="page"] { color: #fff; }
  .products summary[aria-current="page"]::after { content: ""; position: absolute; left: 50%; bottom: 0; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 10px var(--signal); }
  .products summary :global(svg) { transition: transform .2s; }
  .products[open] summary :global(svg) { transform: rotate(180deg); }
  .products-menu { position: absolute; left: 50%; top: calc(100% + 8px); width: 280px; margin-left: -140px; padding: 6px; list-style: none; border-radius: 16px; background: #13131e; box-shadow: 0 0 0 1px rgb(255 255 255 / .1), 0 24px 60px -12px rgb(0 0 0 / .7); }
  .products-menu a { display: grid; gap: 2px; padding: 10px 12px; border-radius: 10px; color: #f4f2fb; }
  .products-menu a:hover { background: rgb(255 255 255 / .07); }
  .products-menu .name { font-size: 14px; font-weight: 600; }
  .products-menu .note { font-size: 13px; color: rgb(244 242 251 / .6); }
  .products-menu .all { margin-top: 6px; padding-top: 6px; border-top: 1px solid rgb(255 255 255 / .08); }
  .products-menu .all a { display: flex; align-items: center; justify-content: space-between; font-size: 14px; color: rgb(244 242 251 / .8); }
  small { font-family: var(--font-hud); font-size: 10px; opacity: .6; }
  .actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  @media (min-width: 960px) { .nav { display: flex; } .actions { margin-left: 0; } .menu { display: none; } }
  @media (min-width: 960px) and (max-width: 1119px) { .bar { gap: 12px; } .nav { gap: 0; } .nav > a { padding-inline: 10px; } .products summary { padding-inline: 10px 8px; } .get { padding: 0 14px; } }
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .lang { position: relative; }
  .lang summary { display: flex; align-items: center; gap: 6px; height: 40px; padding: 0 12px; border-radius: 999px; color: rgb(244 242 251 / .78); }
  .lang summary:hover, .lang[open] summary { background: rgb(255 255 255 / .08); color: #fff; }
  .lang-menu { position: absolute; right: 0; top: calc(100% + 8px); width: 220px; max-height: min(70vh, 560px); overflow: auto; padding: 6px; list-style: none; border-radius: 16px; background: #13131e; box-shadow: 0 0 0 1px rgb(255 255 255 / .1), 0 24px 60px -12px rgb(0 0 0 / .7); }
  .lang-menu a { display: block; padding: 9px 12px; border-radius: 10px; font-size: 14px; color: rgb(244 242 251 / .8); }
  .lang-menu a:hover { background: rgb(255 255 255 / .07); color: #fff; }
  .lang-menu a[aria-current] { color: #fff; background: color-mix(in oklab, var(--signal) 22%, transparent); }
  .get { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px; border-radius: 999px; background: #f4f2fb; color: #07070c; font-size: 14px; font-weight: 600; box-shadow: 0 6px 24px -8px var(--signal); transition: transform .2s var(--ease-snap), box-shadow .2s; }
  .get:hover { transform: translateY(-1px); box-shadow: 0 10px 30px -6px var(--signal); }
  .menu summary { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; color: #f4f2fb; }
  .menu :global(.i-close), .menu[open] :global(.i-open) { display: none; }
  .menu[open] :global(.i-close) { display: block; }
  .menu-sheet { position: fixed; inset: 72px 0 0; display: flex; flex-direction: column; padding: 24px clamp(16px, 3vw, 40px); background: rgb(7 7 12 / .96); backdrop-filter: blur(18px); }
  .menu-sheet a { display: grid; grid-template-columns: 40px 1fr auto; align-items: center; padding: 18px 0; border-bottom: 1px solid rgb(255 255 255 / .08); }
  .menu-sheet .hud { color: var(--signal); }
  .menu-sheet .display { font-size: clamp(32px, 9vw, 48px); line-height: 1; }
  @media (max-width: 420px) { .get span { display: none; } .get { width: 40px; padding: 0; justify-content: center; } .lang summary .hud { display: none; } }
</style>
