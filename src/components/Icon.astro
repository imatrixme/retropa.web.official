type Name = keyof typeof paths
interface Props { name: Name; size?: number; class?: string; strokeWidth?: number }
const { name, size = 20, class: className, strokeWidth = 1.8 } = Astro.props
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
