---
import { phrases } from "@/lib/phrases"
import AppStoreCTA from "@/components/AppStoreCTA.astro"
import Icon from "@/components/Icon.astro"
import DisplayCompare from "@/islands/DisplayCompare.tsx"
import type { Locale } from "@/i18n/locales"
import { displayCopy, localizedDisplayModes, initialDisplayMode } from "@/content/display-study"
import { siteLink, languageTag } from "@/lib/links"

interface Props { locale: Locale; linked?: boolean; heading?: "h2" | "h3" }
const { locale, linked = true } = Astro.props
const copy = displayCopy(locale)
const modes = localizedDisplayModes(locale).map(({ id, name, title, detail, label }) => ({ id, name, title, detail, label }))
const islandCopy = { premium: copy.premium, basic: copy.basic, compare: copy.compare, size: copy.size, pause: copy.pause, play: copy.play, preview: copy.preview, source: copy.source, output: copy.output, loading: copy.loading, fallback: copy.fallback, fallbackAlt: copy.fallbackAlt, canvasLabel: copy.canvasLabel }
const guide = siteLink("crt-filters", locale)
---
<section id="display-study" class="display-section ground-tube" data-feature="filters">
  <div class="shell">
    <header class="head reveal">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 class="display">{phrases(copy.title).map(part => <span class="phrase">{part}</span>)}</h2>
      <p class="intro">{copy.intro}</p>
    </header>
    <DisplayCompare client:visible={{ rootMargin: "600px" }} modes={modes} copy={islandCopy} initial={initialDisplayMode} />
    <p class="note">{copy.note}</p>
    <div class="benefit">
      <div class="benefit-lead reveal">
        <h3>{copy.benefitTitle}</h3>
        <p>{copy.benefit}</p>
      </div>
      <dl>
        {copy.comparison.map(([title, description], index) => <div class:list={["cmp", "reveal", { hi: index === 1 }]}><dt>{title}</dt><dd>{description}</dd></div>)}
      </dl>
    </div>
    <p class="boundary">{copy.boundary}</p>
    <div class="foot">
      <AppStoreCTA locale={locale} page={linked ? "home" : "crt-filters"} placement="filters" note={copy.plus} />
      {linked && <a class="link-arrow more" href={guide.href} hreflang={guide.hreflang}>{copy.link}{guide.foreign && <small lang={guide.hreflang}>{languageTag(guide.hreflang)}</small>}<Icon name="arrow-right" size={18} /></a>}
    </div>
  </div>
</section>
<style>
  @media (min-width: 768px) { :lang(ja) .phrase, :lang(zh-Hans) .phrase { display: inline-block; white-space: nowrap; } }
  :lang(ja) h1, :lang(ja) h2 { font-size: clamp(34px, 4.8vw, 76px); line-height: 1.08; }
  .display-section { position: relative; padding: clamp(96px, 12vw, 160px) 0; overflow: hidden; }
  .display-section::before { content: ""; position: absolute; inset: 10% -20% auto; height: 70%; background: radial-gradient(closest-side, color-mix(in oklab, var(--signal) 26%, transparent), transparent); pointer-events: none; }
  .head { position: relative; display: grid; gap: 18px; max-width: 900px; margin-bottom: 56px; }
  h2 { font-size: clamp(44px, 7vw, 104px); color: #fff; }
  .intro { max-width: 60ch; font-size: clamp(17px, 1.5vw, 20px); color: rgb(244 242 251 / .72); }
  .note { margin-top: 20px; max-width: 90ch; font-size: 13px; color: rgb(244 242 251 / .45); }
  .benefit { display: grid; gap: 32px; margin-top: 96px; }
  @media (min-width: 1000px) { .benefit { grid-template-columns: 1fr 1.2fr; gap: 72px; } }
  h3 { font-family: var(--display-face); font-weight: 750; font-stretch: var(--display-stretch); letter-spacing: var(--display-tracking); font-size: clamp(30px, 3.4vw, 48px); line-height: 1; margin-bottom: 18px; }
  .benefit-lead p { color: rgb(244 242 251 / .72); }
  dl { display: grid; gap: 14px; }
  .cmp { padding: 24px 26px; border-radius: 22px; background: rgb(255 255 255 / .04); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .08); }
  .cmp.hi { background: linear-gradient(135deg, color-mix(in oklab, var(--signal) 20%, transparent), rgb(255 255 255 / .03)); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--signal) 55%, transparent); }
  dt { font-weight: 700; margin-bottom: 8px; }
  dd { margin: 0; font-size: 15px; color: rgb(244 242 251 / .7); }
  .boundary { margin-top: 32px; font-size: 14px; color: rgb(244 242 251 / .5); max-width: 80ch; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; margin-top: 56px; padding-top: 40px; border-top: 1px solid rgb(255 255 255 / .08); }
  .more { color: var(--signal-2); }
  small { font-family: var(--font-hud); font-size: 10px; opacity: .6; margin-left: 4px; }

  /* Island styles */
  .display-section :global(.dc) { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 1100px) { .display-section :global(.dc) { grid-template-columns: minmax(0, 1fr) 340px; gap: 48px; } }
  .display-section :global(.dc-stage-wrap) { margin-inline: auto; transition: width .3s var(--ease-snap); max-width: 100%; }
  .display-section :global(.dc-stage) { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: clamp(18px, 2.4vw, 32px); background: #000; box-shadow: 0 0 0 1px rgb(255 255 255 / .1), 0 0 0 10px #101019, 0 0 0 11px rgb(255 255 255 / .06), 0 40px 120px -30px color-mix(in oklab, var(--signal) 60%, transparent); touch-action: pan-y; }
  .display-section :global(.dc-stage[data-comparing="true"]) { cursor: ew-resize; }
  .display-section :global(.dc-canvas), .display-section :global(.dc-fallback) { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; transition: opacity .4s; }
  .display-section :global(.dc-vignette) { position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 80px rgb(0 0 0 / .55); border-radius: inherit; background: linear-gradient(160deg, rgb(255 255 255 / .06), transparent 30%); }
  .display-section :global(.dc-divider) { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 16px var(--signal); pointer-events: none; }
  .display-section :global(.dc-divider span) { position: absolute; top: 50%; left: 50%; width: 36px; height: 36px; margin: -18px 0 0 -18px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 6px rgb(255 255 255 / .18); }
  .display-section :global(.dc-tag) { position: absolute; top: 14px; z-index: 2; padding: 6px 10px; border-radius: 999px; background: rgb(7 7 12 / .7); backdrop-filter: blur(8px); font-family: var(--font-hud); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; }
  .display-section :global(.dc-tag-left) { left: 14px; }
  .display-section :global(.dc-tag-right) { right: 14px; color: var(--signal-2); }
  .display-section :global(.dc-panel) { display: grid; gap: 22px; }
  .display-section :global(.dc-group) { display: grid; gap: 10px; }
  .display-section :global(.dc-group .hud) { color: rgb(244 242 251 / .5); }
  .display-section :global(.dc-modes) { display: flex; flex-wrap: wrap; gap: 8px; }
  .display-section :global(.dc-modes button) { height: 40px; padding: 0 16px; border: 0; border-radius: 999px; background: rgb(255 255 255 / .06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .1); font-size: 14px; font-weight: 500; transition: background-color .2s, box-shadow .2s, color .2s; }
  .display-section :global(.dc-modes button:hover:not(:disabled)) { background: rgb(255 255 255 / .12); }
  .display-section :global(.dc-modes button[aria-pressed="true"]) { background: #f4f2fb; color: #07070c; box-shadow: 0 0 24px -4px var(--signal); }
  .display-section :global(.dc-modes button:disabled) { opacity: .45; cursor: default; }
  .display-section :global(.dc-detail) { min-height: 120px; padding: 18px 20px; border-radius: 18px; background: rgb(255 255 255 / .04); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .08); }
  .display-section :global(.dc-detail strong) { display: block; margin-bottom: 6px; color: var(--signal-2); }
  .display-section :global(.dc-detail p) { font-size: 15px; color: rgb(244 242 251 / .72); }
  .display-section :global(.dc-controls) { display: grid; grid-template-columns: auto 1fr; gap: 14px 16px; align-items: center; }
  .display-section :global(.dc-controls label) { display: grid; gap: 6px; grid-column: 2; }
  .display-section :global(.dc-controls label:first-of-type) { grid-row: 1; }
  .display-section :global(.dc-controls .hud) { color: rgb(244 242 251 / .5); font-size: 11px; }
  .display-section :global(.dc-play) { grid-row: 1 / span 2; display: grid; place-items: center; width: 56px; height: 56px; border: 0; border-radius: 50%; background: rgb(255 255 255 / .08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .14); }
  .display-section :global(.dc-play:hover:not(:disabled)) { background: rgb(255 255 255 / .16); }
  .display-section :global(input[type="range"]) { width: 100%; accent-color: var(--signal); }
  .display-section :global(.dc-output) { color: rgb(244 242 251 / .4); font-size: 11px; }
</style>
