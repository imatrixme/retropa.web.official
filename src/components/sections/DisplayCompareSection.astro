---
import { phrases } from "@/lib/phrases"
import AppStoreCTA from "@/components/AppStoreCTA.astro"
import Icon from "@/components/Icon.astro"
import FilterCompare from "@/islands/FilterCompare.tsx"
import type { Locale } from "@/i18n/locales"
import { displayCopy } from "@/content/display-study"
import { galleryFilters, galleryCopy, filterText, filterImage } from "@/content/filter-gallery"
import { siteLink, languageTag } from "@/lib/links"

interface Props { locale: Locale; linked?: boolean; heading?: "h2" | "h3" }
const { locale, linked = true } = Astro.props
const copy = displayCopy(locale)
const gallery = galleryCopy(locale)
// A cross-section of the catalog; the full set lives on the filters page.
const featured = ["crt-v4", "trinitron-v1", "fd-trinitron", "arcade-p22", "brick-dmg", "game-gear-stn", "vhs", "pinball-dmd"]
const modes = featured.map(key => galleryFilters.find(item => item.id === `retropa-${key}`)!).map(item => ({
  id: item.id, name: item.name, detail: filterText(item, locale), filtered: filterImage(item.id).full, original: `/media/filters/original-${item.fixture}.webp`,
}))
const islandCopy = { original: gallery.original, compare: copy.compare, picker: copy.premium }
const guide = siteLink("crt-filters", locale)
---
<section id="display-study" class="display-section ground-tube" data-feature="filters">
  <div class="shell">
    <header class="head reveal">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 class="display">{phrases(copy.title).map(part => <span class="phrase">{part}</span>)}</h2>
      <p class="intro">{copy.intro}</p>
    </header>
    <FilterCompare client:visible={{ rootMargin: "600px" }} modes={modes} copy={islandCopy} />
    <p class="note">{gallery.source}</p>
    <a class="link-arrow all" href={`${guide.href}#gallery`} hreflang={guide.hreflang}>{gallery.all}<Icon name="arrow-right" size={18} /></a>
    <div class="benefit">
      <div class="benefit-lead reveal">
        <h3>{copy.benefitTitle}</h3>
        <p>{copy.benefit}</p>
      </div>
      <dl>
        {copy.comparison.map(([title, description], index) => <div class:list={["cmp", "reveal", { hi: index === 1 }]}><dt>{title}</dt><dd>{description}</dd></div>)}
      </dl>
    </div>
    <p class="boundary">{copy.boundary}</p>
    <div class="foot">
      <AppStoreCTA locale={locale} page={linked ? "home" : "crt-filters"} placement="filters" note={copy.plus} />
      {linked && <a class="link-arrow more" href={guide.href} hreflang={guide.hreflang}>{copy.link}{guide.foreign && <small lang={guide.hreflang}>{languageTag(guide.hreflang)}</small>}<Icon name="arrow-right" size={18} /></a>}
    </div>
  </div>
</section>
<style>
  @media (min-width: 768px) { :lang(ja) .phrase, :lang(zh-Hans) .phrase { display: inline-block; white-space: nowrap; } }
  :lang(ja) h1, :lang(ja) h2 { font-size: clamp(34px, 4.8vw, 76px); line-height: 1.08; }
  .display-section { position: relative; padding: clamp(96px, 12vw, 160px) 0; overflow: hidden; }
  .display-section::before { content: ""; position: absolute; inset: 10% -20% auto; height: 70%; background: radial-gradient(closest-side, color-mix(in oklab, var(--signal) 26%, transparent), transparent); pointer-events: none; }
  .head { position: relative; display: grid; gap: 18px; max-width: 900px; margin-bottom: 56px; }
  h2 { font-size: clamp(44px, 7vw, 104px); color: #fff; }
  .intro { max-width: 60ch; font-size: clamp(17px, 1.5vw, 20px); color: rgb(244 242 251 / .72); }
  .note { margin-top: 20px; max-width: 90ch; font-size: 13px; color: rgb(244 242 251 / .45); }
  .benefit { display: grid; gap: 32px; margin-top: 96px; }
  @media (min-width: 1000px) { .benefit { grid-template-columns: 1fr 1.2fr; gap: 72px; } }
  h3 { font-family: var(--display-face); font-weight: 750; font-stretch: var(--display-stretch); letter-spacing: var(--display-tracking); font-size: clamp(30px, 3.4vw, 48px); line-height: 1; margin-bottom: 18px; }
  .benefit-lead p { color: rgb(244 242 251 / .72); }
  dl { display: grid; gap: 14px; }
  .cmp { padding: 24px 26px; border-radius: 22px; background: rgb(255 255 255 / .04); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .08); }
  .cmp.hi { background: linear-gradient(135deg, color-mix(in oklab, var(--signal) 20%, transparent), rgb(255 255 255 / .03)); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--signal) 55%, transparent); }
  dt { font-weight: 700; margin-bottom: 8px; }
  dd { margin: 0; font-size: 15px; color: rgb(244 242 251 / .7); }
  .boundary { margin-top: 32px; font-size: 14px; color: rgb(244 242 251 / .5); max-width: 80ch; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; margin-top: 56px; padding-top: 40px; border-top: 1px solid rgb(255 255 255 / .08); }
  .more { color: var(--signal-2); }
  small { font-family: var(--font-hud); font-size: 10px; opacity: .6; margin-left: 4px; }

  .all { display: inline-flex; margin-top: 18px; color: var(--signal-2); }
  /* Island styles */
  .display-section :global(.fc) { display: grid; gap: 28px; align-items: start; }
  @media (min-width: 1100px) { .display-section :global(.fc) { grid-template-columns: minmax(0, 1fr) 340px; gap: 48px; } }
  .display-section :global(.fc-stage) { position: relative; aspect-ratio: 3 / 2; overflow: hidden; border-radius: clamp(18px, 2.4vw, 32px); background: #000; box-shadow: 0 0 0 1px rgb(255 255 255 / .1), 0 0 0 10px #101019, 0 0 0 11px rgb(255 255 255 / .06), 0 40px 120px -30px color-mix(in oklab, var(--signal) 60%, transparent); cursor: ew-resize; touch-action: pan-y; user-select: none; }
  .display-section :global(.fc-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .display-section :global(.fc-clip) { position: absolute; inset: 0; }
  .display-section :global(.fc-divider) { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 16px var(--signal); pointer-events: none; }
  .display-section :global(.fc-divider span) { position: absolute; top: 50%; left: 50%; width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 6px rgb(255 255 255 / .18), 0 8px 24px rgb(0 0 0 / .5); }
  .display-section :global(.fc-divider span)::before, .display-section :global(.fc-divider span)::after { content: ""; position: absolute; top: 50%; width: 0; height: 0; margin-top: -5px; border: 5px solid transparent; }
  .display-section :global(.fc-divider span)::before { left: 8px; border-right-color: #07070c; }
  .display-section :global(.fc-divider span)::after { right: 8px; border-left-color: #07070c; }
  .display-section :global(.fc-tag) { position: absolute; top: 14px; z-index: 2; padding: 6px 10px; border-radius: 999px; background: rgb(7 7 12 / .72); backdrop-filter: blur(8px); font-family: var(--font-hud); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; pointer-events: none; }
  .display-section :global(.fc-left) { left: 14px; }
  .display-section :global(.fc-right) { right: 14px; color: var(--signal-2); }
  .display-section :global(.fc-panel) { display: grid; gap: 22px; }
  .display-section :global(.fc-range) { display: grid; gap: 8px; }
  .display-section :global(.fc-range .hud) { color: rgb(244 242 251 / .5); }
  .display-section :global(.fc-range input) { width: 100%; accent-color: var(--signal); }
  .display-section :global(.fc-modes) { display: flex; flex-wrap: wrap; gap: 8px; }
  .display-section :global(.fc-modes button) { min-height: 38px; padding: 0 14px; border: 0; border-radius: 999px; background: rgb(255 255 255 / .06); color: rgb(244 242 251 / .8); font-size: 14px; font-weight: 600; cursor: pointer; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .1); transition: background-color .2s, color .2s; }
  .display-section :global(.fc-modes button:hover) { background: rgb(255 255 255 / .1); }
  .display-section :global(.fc-modes button[aria-pressed="true"]) { background: #f4f2fb; color: #07070c; box-shadow: 0 0 24px -6px var(--signal); }
  /* All descriptions share one grid cell, so the slot is as tall as the longest. */
  .display-section :global(.fc-detail) { display: grid; }
  .display-section :global(.fc-detail p) { grid-area: 1 / 1; margin: 0; color: rgb(244 242 251 / .72); font-size: 15px; line-height: 1.6; visibility: hidden; opacity: 0; transition: opacity .25s; }
  .display-section :global(.fc-detail p.is-on) { visibility: visible; opacity: 1; }
  .display-section :global(.fc-detail strong) { display: block; margin-bottom: 6px; color: #fff; font-size: 17px; }
</style>
